# ============================================================================
# Bani Suef irrigation-suitability digital-soil-mapping repository
# ----------------------------------------------------------------------------
# Strict include-list .gitignore: ignore everything by default and explicitly
# whitelist the files that constitute the public, Zenodo-archivable repo.
# ============================================================================

# 1. Ignore everything ------------------------------------------------------
*

# 2. Re-include directory descents we want to traverse ----------------------
!.gitignore
!.gitattributes
!README.md
!SETUP.md
!LICENSE
!CITATION.cff
!.zenodo.json
!requirements.txt
!environment.yml
!CHANGELOG.md
!CONTRIBUTING.md

# Notebooks / scripts directory ---------------------------------------------
!notebooks/
notebooks/*
!notebooks/*.py
!notebooks/*.ipynb
!notebooks/README.md
notebooks/__pycache__/
notebooks/.ipynb_checkpoints/

# Lightweight reference data only -------------------------------------------
!data/
data/*
!data/README.md
!data/countries.geojson
!data/ne_10m_rivers.geojson

# Outputs: ship only its README (results regenerated by scripts) ------------
!outputs/
outputs/*
!outputs/README.md

# Private folders never to commit -------------------------------------------
submission/
manuscript/

# Secrets / credentials -----------------------------------------------------
.secrets/
*.key
*.pem
*.env
.env

# Bulky / non-redistributable local data ------------------------------------
Layers/
Crop_March2025_11/
Crop_March2025_11.zip
Analysis/

# Python noise --------------------------------------------------------------
__pycache__/
*.py[cod]
*.so
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/
.python-version

# OS / IDE ------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Build / dist --------------------------------------------------------------
build/
dist/
*.egg-info/

# Helper scripts kept local-only --------------------------------------------
manuscript/_apply_*.py
manuscript/_make_*.py
*.docx
*.pdf
*.xls
*.xlsx
